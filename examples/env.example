# Example environment configuration for youtube-channel-mcp.
# Copy the variables you need into your shell profile or your cloud environment's settings.
# NEVER commit a filled-in copy of this file. Values below are placeholders, not secrets.

# --- Optional: where config/credentials live (defaults shown) ---
# YT_MCP_CONFIG_DIR=~/.config/youtube-channel-mcp
# YT_MCP_CLIENT_SECRET_FILE=~/.config/youtube-channel-mcp/client_secret.json
# YT_MCP_TOKEN_FILE=~/.config/youtube-channel-mcp/token.json

# --- Optional: logging (stderr only, secrets are redacted) ---
# YT_MCP_LOG_LEVEL=info   # debug | info | warn | error

# --- Headless / cloud mode (see docs/CLOUD_SESSIONS.md) ---
# Get real values on your own computer with `youtube-channel-mcp env-export`.
# Store them as secrets in your environment settings, not in files.
# YT_MCP_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# YT_MCP_CLIENT_SECRET=<your-client-secret>
# YT_MCP_REFRESH_TOKEN=<your-refresh-token>
# YT_MCP_SCOPES="https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly"
