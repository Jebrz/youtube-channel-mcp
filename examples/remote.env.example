# Environment for `youtube-channel-mcp serve-http` (the remote connector).
# Placeholders only. Store real values in your host's secret manager, never in Git.

# Public HTTPS origin of the deployment (no path). The MCP URL becomes <this>/mcp.
YT_MCP_PUBLIC_URL=https://yt-mcp-xxxxxxxx.a.run.app
# scrypt hash of the owner passphrase: `youtube-channel-mcp hash-password`
YT_MCP_OWNER_PASSWORD_HASH=scrypt$32768$8$1$<salt>$<hash>
# The ONLY channel this deployment may serve (from get_channel_overview / YouTube Studio)
YT_MCP_EXPECTED_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# Google credentials (from `youtube-channel-mcp env-export` on your own computer) -> SECRETS
YT_MCP_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
YT_MCP_CLIENT_SECRET=<secret>
YT_MCP_REFRESH_TOKEN=<secret>
YT_MCP_SCOPES="https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly"

# Runtime
YT_MCP_HTTP_HOST=0.0.0.0
PORT=8080
YT_MCP_TRUST_PROXY=1          # behind Cloud Run / a reverse proxy, so lockouts use the client IP
YT_MCP_STATE_FILE=/state/remote-oauth-state.json   # persistent volume; or "memory"
YT_MCP_DASHBOARD_TTL_SECONDS=900
