{
  "name": "youtube-channel-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server that lets Claude Code read an authorized YouTube channel's content and analytics via the official YouTube Data API v3 and YouTube Analytics API.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "youtube-channel-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "live-check": "node dist/index.js check",
    "start": "node dist/index.js serve",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "youtube",
    "youtube-analytics",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
