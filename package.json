{
  "name": "youtube-channel-mcp",
  "version": "0.2.0",
  "description": "Read-only MCP server and setup tools that let Claude read your own YouTube channel's content and analytics through the official YouTube Data API v3 and YouTube Analytics API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jebrz/youtube-channel-mcp.git"
  },
  "homepage": "https://github.com/Jebrz/youtube-channel-mcp#readme",
  "bugs": {
    "url": "https://github.com/Jebrz/youtube-channel-mcp/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "youtube-channel-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs",
    "examples",
    "skills/youtube-channel-audit",
    "artifacts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node dist/index.js setup",
    "doctor": "node dist/index.js doctor",
    "live-check": "node dist/index.js check",
    "start": "node dist/index.js serve",
    "prepare": "npm run build",
    "pack:check": "node scripts/check-package.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "youtube",
    "youtube-analytics",
    "youtube-data-api",
    "claude",
    "claude-code"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
